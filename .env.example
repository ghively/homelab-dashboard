OPENAI_API_KEY=your-litellm-key
OPENAI_BASE_URL=http://your-litellm-host:4000/v1
OPENAI_MODEL=your-model-name

# Media World adapters
#
# Each service needs both _URL and _API_KEY to register as live. Leave a
# service unset and it keeps falling back to fixture data (source: "fixture") —
# that fallback is intentional, so adapters can be wired a few at a time.
EMBY_URL=http://your-emby-host:8096
EMBY_API_KEY=your-emby-api-key
EMBY_USER_ID=your-emby-user-id

SONARR_URL=http://your-sonarr-host:8989
SONARR_API_KEY=your-sonarr-api-key

RADARR_URL=http://your-radarr-host:7878
RADARR_API_KEY=your-radarr-api-key

SABNZBD_URL=http://your-sabnzbd-host:8080
SABNZBD_API_KEY=your-sabnzbd-api-key

# Tdarr and RomM treat apiKey as optional in their adapter configs, but the
# shared config layer requires _API_KEY to be non-empty before registering.
# Set any placeholder if your instance has no auth.
TDARR_URL=http://your-tdarr-host:8265
TDARR_API_KEY=your-tdarr-api-key

ROMM_URL=http://your-romm-host:8080
ROMM_API_KEY=your-romm-api-key

# Network / ops adapters
#
# These live under src/adapters/ and read their own env vars rather than going
# through the shared config layer. Each module has a placeholder default host,
# and registration is gated on the variable being set explicitly — otherwise
# an unconfigured service would probe that default instead of showing a
# fixture.
PIHOLE_BASE_URL=http://your-pihole-host
PIHOLE_API_KEY=your-pihole-api-token

UNIFI_BASE_URL=https://your-unifi-controller-host
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-unifi-password

# These point at a DOCKER ENGINE API (or a read-only socket-proxy), not at
# Watchtower. Watchtower exposes no container list — only a token-gated
# POST /v1/update — so container inventory comes from GET /containers/json.
WATCHTOWER_VPS_URL=http://your-vps-host:2375
WATCHTOWER_MEDIA_URL=http://your-media-host:2375
WATCHTOWER_STORAGE_URL=http://your-storage-host:2375

SEARXNG_URL=http://your-searxng-host:8888

# AI adapters
OLLAMA_URL=http://your-ollama-host:11434
LITELLM_URL=http://your-litellm-host:4000
LITELLM_API_KEY=your-litellm-master-key
COMFYUI_URL=http://your-comfyui-host:8188

# Infrastructure adapters
CADDY_ADMIN_URL=http://your-caddy-host:2019
SPOOLMAN_URL=http://your-spoolman-host:7912
SYNCTHING_URL=http://your-syncthing-host:8384
SYNCTHING_API_KEY=your-syncthing-api-key

# Synology DSM needs an account, not an API key — DSM issues a session id.
SYNOLOGY_URL=http://your-synology-host:5000
SYNOLOGY_USER=your-dsm-user
SYNOLOGY_PASSWORD=your-dsm-password

# Garage needs the ADMIN api + token. S3 access keys cannot query cluster state.
GARAGE_ADMIN_URL=http://your-garage-host:3903
GARAGE_ADMIN_TOKEN=your-garage-admin-token

# Security adapters
#
# Wazuh Indexer and Dashboard are HTTPS with basic auth and a self-signed cert.
# WAZUH_USER/WAZUH_PASSWORD apply to both unless overridden per service.
# WAZUH_INSECURE_TLS=1 relaxes certificate verification for THESE REQUESTS ONLY
# (a per-request undici dispatcher, not NODE_TLS_REJECT_UNAUTHORIZED, which
# would disable verification process-wide). Prefer NODE_EXTRA_CA_CERTS if you
# can point it at the internal CA.
WAZUH_USER=admin
WAZUH_PASSWORD=your-wazuh-password
WAZUH_INSECURE_TLS=1
FAIL2BAN_API_URL=http://your-fail2ban-host:5001
# The Manager API uses its own credentials, NOT the indexer/dashboard pair —
# those return "Invalid credentials" against /security/user/authenticate.
WAZUH_MANAGER_URL=https://your-wazuh-host:55000
WAZUH_INDEXER_URL=https://your-wazuh-host:9200
WAZUH_DASHBOARD_URL=https://your-wazuh-host:443

CLOUDFLARE_DNS_API_KEY=your-cloudflare-api-token
CLOUDFLARE_DNS_ZONE_ID=your-cloudflare-zone-id

# Reachability-probe-only services (no documented metrics API)
HERMES_GATEWAY_URL=http://your-gateway-host:8642
HERMES_DASHBOARD_URL=http://your-dashboard-host:9119
HERMES_API_SERVER_URL=http://your-api-host:8000
HERMES_MCP_BRIDGE_URL=http://your-mcp-bridge-host:8083
HERMES_WORKSPACE_URL=http://your-workspace-host:3000

# ═══════════════════════════════════════════════════════════════════════════
# Adapters wired under src/lib/registration/<world>.ts (per-world registration)
#
# An adapter registers on its URL, so a reachable service with a missing
# token renders `denied` (naming the var) rather than a healthy-looking
# fixture.
# ═══════════════════════════════════════════════════════════════════════════

# ── AI world ──
OMNIROUTE_URL=http://your-omniroute-host:20128
OMNIROUTE_API_URL=http://your-omniroute-host:20129
# OMNIROUTE_API_KEY=your-omniroute-manage-key
AGENT_VAULT_URL=http://127.0.0.1:7778
AGENT_VAULT_TOKEN=your-agent-vault-token
HERMES_API_SERVER_KEY=your-hermes-api-server-key
# hermes-mcp-bridge has no /health route; adapter reads the OAuth well-known.
# POST /mcp is 401 -> `denied` until HERMES_MCP_BRIDGE_TOKEN is set.
# openwebui-vector reuses OPENWEBUI_URL; needs OPENWEBUI_TOKEN.
# OPENWEBUI_TOKEN=your-openwebui-api-key

# ── Home world ──
HOME_ASSISTANT_URL=http://your-home-assistant-host:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token
# mqtt: raw TCP CONNECT/CONNACK reachability + latency only. Anonymous
# connect is refused on most brokers -> `denied` until credentials are set.
MQTT_BROKER_URL=mqtt://your-mqtt-host:1883
# MQTT_USERNAME=your-mqtt-user
# MQTT_PASSWORD=your-mqtt-password
NODE_RED_URL=http://your-node-red-host:1880
WYOMING_ENDPOINTS=piper=your-voice-host:10201,mac-daemon=your-voice-host:10300,openwakeword=your-voice-host:10400
STALWART_URL=http://127.0.0.1:8080
# STALWART_ADMIN_USER=
# STALWART_ADMIN_PASSWORD=
ROUNDCUBE_URL=http://your-roundcube-host:8000
VIKUNJA_URL=http://your-vikunja-host:3456
VIKUNJA_TOKEN=your-vikunja-api-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# wiki + knowledge-graph read a local markdown corpus directly.
WIKI_PATH=/path/to/your/wiki
KNOWLEDGE_GRAPH_PATH=/path/to/your/wiki
# calendar: CalDAV; PROPFIND is 401 -> `denied` until creds set. Only the
# unauthenticated path is exercised; upcoming-event listing is not implemented.
CALDAV_URL=http://127.0.0.1:8080/dav/cal
# CALDAV_USERNAME=
# CALDAV_PASSWORD=

# ── Ops world ──
# alloy: Grafana Alloy on THIS host (loopback is fine, same host).
ALLOY_URL=http://127.0.0.1:12345
# docker: read via Prometheus over cAdvisor — no host publishes the Docker
# Engine API over TCP. Only RUNNING containers on cAdvisor-scraped hosts.
DOCKER_PROMETHEUS_URL=http://your-prometheus-host:9090
ALERTMANAGER_URL=http://your-alertmanager-host:9093

# ── Infrastructure world ──
# gpu: no DCGM/nvidia exporter reachable; read from ComfyUI /system_stats
# instead (real torch CUDA report).
GPU_STATS_URL=http://your-comfyui-host:8188
# valkey: RESP over a raw socket. HOST is the container's docker-network IP;
# it changes if the container is recreated (then the panel shows `offline`,
# not stale data). A published port or stable alias would be more durable.
VALKEY_HOST=your-valkey-host
VALKEY_PORT=6379
# VALKEY_PASSWORD=
# onepanel: v2 API-key handshake (1Panel-Token = md5("1panel"+key+ts)).
ONEPANEL_BASE_URL=http://127.0.0.1:10086
# ONEPANEL_API_KEY=set-in-1Panel-Settings-API-Interface

# ── Security world ──
# 1password: reads vaults via the installed `op` CLI. Needs a service-account
# token.
# OP_SERVICE_ACCOUNT_TOKEN=your-op-service-account-token
