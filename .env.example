OPENAI_API_KEY=your-litellm-key
OPENAI_BASE_URL=http://gh-arm:4000/v1
OPENAI_MODEL=deepseek-v4-pro

# Media World adapters
#
# Each service needs both _URL and _API_KEY to register as live. Leave a
# service unset and it keeps falling back to fixture data (source: "fixture") —
# that fallback is intentional, so adapters can be wired a few at a time.
#
# HOSTS VERIFIED BY PORT SCAN over the tailnet (2026-08-02). The previous
# defaults put Sonarr and SABnzbd on gh-media; they are actually on gh-storage.
# Note there is no `gh-vps` node on this tailnet — 100.92.162.32 is gh-ai.
#
#   gh-ai       100.92.162.32
#   gh-arm      100.65.126.126   litellm :4000, ntfy :8080, :8082 (307)
#   gh-media    100.116.139.100  emby :8096
#   gh-nvidia   100.88.26.95     comfyui :8188   (ollama :11434 NOT listening)
#   gh-storage  100.88.40.87     dsm :5000, sabnzbd :8080, syncthing :8384,
#                                sonarr :8989
#
# Confirmed live and returning real data: comfyui, litellm, synology-dsm,
# sonarr, radarr, sabnzbd, syncthing.
# Reachable, still needs a key: emby.
# Not listening anywhere on the tailnet: ollama, tdarr, caddy admin (2019).
#
# Credentials live in 1Password (vault "Gregory"); Hermes holds a service
# account token in ~/.hermes/.env as OP_SERVICE_ACCOUNT_TOKEN.
EMBY_URL=http://gh-media:8096        # verified live
EMBY_API_KEY=your-emby-api-key
EMBY_USER_ID=your-emby-user-id

SONARR_URL=http://gh-storage:8989    # verified live
SONARR_API_KEY=your-sonarr-api-key

# Radarr listens on 8310, not the 7878 default.
RADARR_URL=http://gh-storage:8310
RADARR_API_KEY=your-radarr-api-key

SABNZBD_URL=http://gh-storage:8080   # verified live
SABNZBD_API_KEY=your-sabnzbd-api-key

# Tdarr and RomM treat apiKey as optional in their adapter configs, but the
# shared config layer requires _API_KEY to be non-empty before registering.
# Set any placeholder if your instance has no auth.
# Tdarr was not found listening on any tailnet host (port 8265 closed).
TDARR_URL=http://gh-media:8265
TDARR_API_KEY=your-tdarr-api-key

# gh-arm:8082 is cAdvisor, not RomM. RomM host/port is unconfirmed.
ROMM_URL=http://gh-arm:8082
ROMM_API_KEY=your-romm-api-key

# Network / ops adapters
#
# These live under src/adapters/ and read their own env vars rather than going
# through the shared config layer. Each module has a hardcoded default host, so
# registration is gated on the variable being set explicitly — otherwise an
# unconfigured service would probe that default instead of showing a fixture.
# Pi-hole and UniFi are LAN-only (192.168.0.x) and are NOT routable over the
# tailnet — unreachable from a VPS-hosted dashboard.
PIHOLE_BASE_URL=http://192.168.0.50
PIHOLE_API_KEY=your-pihole-api-token

UNIFI_BASE_URL=https://192.168.0.1
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-unifi-password

# These point at a DOCKER ENGINE API (or a read-only socket-proxy), not at
# Watchtower. Watchtower exposes no container list — only a token-gated
# POST /v1/update — so container inventory comes from GET /containers/json.
WATCHTOWER_VPS_URL=http://100.92.162.32:2375
WATCHTOWER_MEDIA_URL=http://100.116.139.100:2375
WATCHTOWER_STORAGE_URL=http://100.88.40.87:2375

# SearXNG binds to 127.0.0.1 on gh-ai — not reachable over the tailnet.
SEARXNG_URL=http://gh-ai:8888

# AI adapters
# Ollama is NOT listening on gh-nvidia:11434 (port closed; it likely binds
# to localhost). Expose it or front it with a proxy before enabling.
OLLAMA_URL=http://gh-nvidia:11434    # port closed; gh-nvidia runs Grafana :3000, SynapseNAS :7777
LITELLM_URL=http://gh-arm:4000       # verified live
LITELLM_API_KEY=your-litellm-master-key
COMFYUI_URL=http://gh-nvidia:8188   # verified live

# Infrastructure adapters
# Caddy admin API (2019) was not found listening on any tailnet host.
CADDY_ADMIN_URL=http://gh-ai:2019
SPOOLMAN_URL=http://gh-ai:7912       # host/port unconfirmed
SYNCTHING_URL=http://gh-storage:8384 # verified live
SYNCTHING_API_KEY=your-syncthing-api-key

# Synology DSM needs an account, not an API key — DSM issues a session id.
SYNOLOGY_URL=http://gh-storage:5000  # verified live
SYNOLOGY_USER=your-dsm-user
SYNOLOGY_PASSWORD=your-dsm-password

# Garage needs the ADMIN api + token. S3 access keys cannot query cluster state.
GARAGE_ADMIN_URL=http://gh-ai:3903   # host/port unconfirmed
GARAGE_ADMIN_TOKEN=your-garage-admin-token

# Security adapters
#
# Wazuh Indexer and Dashboard are HTTPS with basic auth and a self-signed cert.
# WAZUH_USER/WAZUH_PASSWORD apply to both unless overridden per service.
# WAZUH_INSECURE_TLS=1 relaxes certificate verification for THESE REQUESTS ONLY
# (a per-request undici dispatcher, not NODE_TLS_REJECT_UNAUTHORIZED, which
# would disable verification process-wide). Prefer NODE_EXTRA_CA_CERTS if you
# can point it at the internal CA.
WAZUH_USER=admin
WAZUH_PASSWORD=your-wazuh-password
WAZUH_INSECURE_TLS=1
FAIL2BAN_API_URL=http://gh-ai:5001   # requires a sidecar exposing /status
# The Manager API uses its own credentials, NOT the indexer/dashboard pair —
# those return "Invalid credentials" against /security/user/authenticate.
WAZUH_MANAGER_URL=https://gh-arm:55000
WAZUH_INDEXER_URL=https://gh-arm:9200    # verified live
WAZUH_DASHBOARD_URL=https://gh-arm:443   # verified live

CLOUDFLARE_DNS_API_KEY=your-cloudflare-api-token
CLOUDFLARE_DNS_ZONE_ID=your-cloudflare-zone-id

# Hermes services — reachability probes only (no documented metrics API)
HERMES_GATEWAY_URL=http://gh-ai:8642      # verified reachable
HERMES_DASHBOARD_URL=http://gh-ai:9119    # verified reachable
HERMES_API_SERVER_URL=http://gh-ai:8000   # Honcho API
HERMES_MCP_BRIDGE_URL=http://gh-ai:8083   # port unconfirmed
HERMES_WORKSPACE_URL=http://gh-ai:3000    # verified reachable
