OPENAI_API_KEY=your-litellm-key
OPENAI_BASE_URL=http://gh-arm:4000/v1
OPENAI_MODEL=deepseek-v4-pro

# Media World adapters
#
# Each service needs both _URL and _API_KEY to register as live. Leave a
# service unset and it keeps falling back to fixture data (source: "fixture") —
# that fallback is intentional, so adapters can be wired a few at a time.
EMBY_URL=http://gh-media:8096
EMBY_API_KEY=your-emby-api-key
EMBY_USER_ID=your-emby-user-id

SONARR_URL=http://gh-media:8989
SONARR_API_KEY=your-sonarr-api-key

RADARR_URL=http://gh-media:7878
RADARR_API_KEY=your-radarr-api-key

SABNZBD_URL=http://gh-media:8080
SABNZBD_API_KEY=your-sabnzbd-api-key

# Tdarr and RomM treat apiKey as optional in their adapter configs, but the
# shared config layer requires _API_KEY to be non-empty before registering.
# Set any placeholder if your instance has no auth.
TDARR_URL=http://gh-media:8265
TDARR_API_KEY=your-tdarr-api-key

ROMM_URL=http://gh-media:8082
ROMM_API_KEY=your-romm-api-key

# Network / ops adapters
#
# These live under src/adapters/ and read their own env vars rather than going
# through the shared config layer. Each module has a hardcoded default host, so
# registration is gated on the variable being set explicitly — otherwise an
# unconfigured service would probe that default instead of showing a fixture.
PIHOLE_BASE_URL=http://192.168.0.50
PIHOLE_API_KEY=your-pihole-api-token

UNIFI_BASE_URL=https://192.168.0.1
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-unifi-password

WATCHTOWER_VPS_URL=http://100.92.162.32:8080
WATCHTOWER_MEDIA_URL=http://100.116.139.100:8080
WATCHTOWER_STORAGE_URL=http://100.88.40.87:8080

SEARXNG_URL=http://gh-vps:8888

# AI adapters
OLLAMA_URL=http://gh-nvidia:11434
LITELLM_URL=http://gh-arm:4000
LITELLM_API_KEY=your-litellm-master-key
COMFYUI_URL=http://gh-nvidia:8188

# Infrastructure adapters
CADDY_ADMIN_URL=http://100.92.162.32:2019
SPOOLMAN_URL=http://gh-vps:7912
SYNCTHING_URL=http://100.88.40.87:8384
SYNCTHING_API_KEY=your-syncthing-api-key

# Synology DSM needs an account, not an API key — DSM issues a session id.
SYNOLOGY_URL=http://100.88.40.87:5000
SYNOLOGY_USER=your-dsm-user
SYNOLOGY_PASSWORD=your-dsm-password

# Garage needs the ADMIN api + token. S3 access keys cannot query cluster state.
GARAGE_ADMIN_URL=http://gh-vps:3903
GARAGE_ADMIN_TOKEN=your-garage-admin-token

# Security adapters
FAIL2BAN_API_URL=http://gh-vps:5001
WAZUH_MANAGER_URL=https://100.65.126.126:55000
WAZUH_INDEXER_URL=https://100.65.126.126:9200
WAZUH_DASHBOARD_URL=https://100.65.126.126:5601

CLOUDFLARE_DNS_API_KEY=your-cloudflare-api-token
CLOUDFLARE_DNS_ZONE_ID=your-cloudflare-zone-id

# Hermes services — reachability probes only (no documented metrics API)
HERMES_GATEWAY_URL=http://gh-ai:8080
HERMES_DASHBOARD_URL=http://gh-ai:8081
HERMES_API_SERVER_URL=http://gh-ai:8082
HERMES_MCP_BRIDGE_URL=http://gh-ai:8083
HERMES_WORKSPACE_URL=http://gh-ai:8084
